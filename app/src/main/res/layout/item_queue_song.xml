<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Drag Reorder Handle -->
    <ImageView
        android:id="@+id/ivQueueDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Drag to reorder"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/ytm_icon_inactive" />

    <!-- Album Art Thumbnail -->
    <androidx.cardview.widget.CardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="@color/ytm_surface_dark"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivQueueCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album Cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </androidx.cardview.widget.CardView>

    <!-- Song Metadata -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvQueueTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/youtube_sans_bold_font"
            android:maxLines="1"
            android:text="Track Title"
            android:textColor="@color/ytm_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQueueOriginBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_badge"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:text="QUEUED"
                android:textColor="@color/ytm_text_secondary"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQueueArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Artist Name"
                android:textColor="@color/ytm_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Currently Playing Equalizer Badge -->
    <ImageView
        android:id="@+id/ivQueuePlayingIndicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Currently Playing"
        android:src="@drawable/ic_equalizer"
        android:visibility="gone"
        app:tint="@color/ytm_red" />

    <!-- Remove from Queue Button -->
    <ImageView
        android:id="@+id/btnQueueRemove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove from Queue"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:tint="@color/ytm_icon_inactive" />

</LinearLayout>
