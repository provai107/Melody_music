<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCollectionSheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing_sheet"
    android:orientation="vertical">

    <!-- Pinned Top Drag Handle & Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/single_bar_drag_handle" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivCloseCollectionSheet"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="8dp"
                android:src="@drawable/ic_ytm_chevron_down"
                app:tint="@color/textPrimary" />

            <TextView
                android:id="@+id/tvCollectionSheetTopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:ellipsize="end"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:text="Playlist"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCollectionSheetRename"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Rename Playlist"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    android:visibility="gone"
                    app:tint="@color/textSecondary" />

                <ImageView
                    android:id="@+id/ivCollectionSheetAction"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Action"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone"
                    app:tint="@color/accentPrimary" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borderSubtle" />

    <!-- Vertically Scrollable Content (Header, Artwork, Primary Actions, Track List) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="140dp">

            <!-- Hero Playlist Artwork -->
            <androidx.cardview.widget.CardView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surfaceCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/ivCollectionHeroArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Playlist Artwork"
                    android:padding="32dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_library_music"
                    app:tint="@color/accentPrimary" />
            </androidx.cardview.widget.CardView>

            <!-- Playlist Title & Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvCollectionSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/youtube_sans_bold_font"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Playlist Title"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvCollectionSheetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="0 tracks • Melody"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Primary Actions Row (Play All, Shuffle, + Add Tracks) -->
            <LinearLayout
                android:id="@+id/layoutCollectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollectionPlayAll"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accentPrimary"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="▶  Play"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollectionShuffle"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surfaceElevated"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🔀  Shuffle"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollectionAddTracks"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="+ Add"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@color/borderSubtle" />

            <!-- Track List Frame -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Songs RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCollectionSongs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutCollectionEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="36dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivCollectionEmptyIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="No tracks"
                        android:src="@drawable/ic_library_music"
                        app:tint="@color/textDisabled" />

                    <TextView
                        android:id="@+id/tvCollectionEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/youtube_sans_bold_font"
                        android:text="No tracks found"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvCollectionEmptyMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Add songs to enjoy them here."
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCollectionEmptyAction"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/accentPrimary"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Explore Music"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimary"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:cornerRadius="19dp" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
