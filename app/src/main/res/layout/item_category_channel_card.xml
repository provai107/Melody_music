<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="148dp"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surfaceCard"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:id="@+id/layoutChannelCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_channel_card_maroon"
        android:padding="14dp">

        <!-- Decorative Composition Graphic in Lower Right -->
        <TextView
            android:id="@+id/tvChannelDecorativeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:alpha="0.80"
            android:rotation="-8"
            android:text="💖"
            android:textSize="48sp" />

        <!-- Category Title & Subtitle in Top Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChannelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:maxLines="2"
                android:text="Romance"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvChannelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Love &amp; Passion"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Compact Bottom Pill Badge -->
        <TextView
            android:id="@+id/tvChannelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_pill_badge"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="EXPLORE"
            android:textColor="@color/textPrimary"
            android:textSize="9sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
