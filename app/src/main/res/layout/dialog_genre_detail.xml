<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivCloseGenre"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_expand_more" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGenreHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="GENRE EXPLORER"
                android:textColor="@color/tidal_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGenreHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Curated tracks &amp; releases"
                android:textColor="@color/tidal_accent"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layoutGenreActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGenrePlayAll"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tidal_accent"
            android:fontFamily="sans-serif-medium"
            android:text="▶ Play All"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGenreShuffleAll"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tidal_surface_card"
            android:fontFamily="sans-serif-medium"
            android:text="🔀 Shuffle"
            android:textColor="@color/tidal_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGenreQueueAll"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tidal_surface_card"
            android:fontFamily="sans-serif-medium"
            android:text="➕ Queue"
            android:textColor="@color/tidal_text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/tidal_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/pbGenreLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/tidal_accent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGenreSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/tvGenreEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:text="Could not load tracks. Check connection."
            android:textColor="@color/tidal_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
