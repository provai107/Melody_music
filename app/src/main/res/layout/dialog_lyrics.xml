<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutLyricsSheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ytm_surface_dark"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- Top Drag Handle -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Drag Handle"
        android:src="@drawable/single_bar_drag_handle" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/ivCloseLyrics"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Lyrics"
            android:padding="6dp"
            android:src="@drawable/ic_ytm_chevron_down"
            app:tint="@color/ytm_icon_active" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:letterSpacing="0.08"
                android:text="LYRICS"
                android:textColor="@color/ytm_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLyricsSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:text="Track Title"
                android:textColor="@color/ytm_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLyricsSongArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:text="Artist"
                android:textColor="@color/ytm_text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/ytm_divider" />

    <!-- Content Area Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/pbLyricsLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ytm_red"
            android:visibility="visible" />

        <!-- Empty / Error Fallback -->
        <LinearLayout
            android:id="@+id/layoutLyricsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="No Lyrics Icon"
                android:src="@drawable/ic_lyrics"
                app:tint="@color/ytm_icon_inactive" />

            <TextView
                android:id="@+id/tvLyricsEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:gravity="center"
                android:text="Lyrics are not available for this track."
                android:textColor="@color/ytm_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRetryLyrics"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Retry"
                android:textColor="@color/ytm_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Lyrics RecyclerView for Synced & Plain Lyrics -->
        <LinearLayout
            android:id="@+id/layoutLyricsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="140dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tvLyricsCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:textColor="@color/ytm_text_tertiary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
