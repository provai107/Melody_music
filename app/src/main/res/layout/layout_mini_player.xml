<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMiniPlayer"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Mini Album Thumbnail -->
        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/surfaceCard"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivMiniCover"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Mini Album Cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_melody_logo" />
        </androidx.cardview.widget.CardView>

        <!-- Title & Artist Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Track Title"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Artist"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick Like Toggle -->
        <ImageView
            android:id="@+id/btnMiniLike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like Track"
            android:padding="8dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/textSecondary" />

        <!-- Quick Play / Pause -->
        <ImageView
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause"
            android:padding="6dp"
            android:src="@drawable/ic_ytm_play"
            app:tint="@color/textPrimary" />

        <!-- Quick Skip Next -->
        <ImageView
            android:id="@+id/btnMiniNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Track"
            android:padding="7dp"
            android:src="@drawable/ic_ytm_skip_next"
            app:tint="@color/textSecondary" />

    </LinearLayout>

    <!-- Bottom Progress Indicator Line -->
    <ProgressBar
        android:id="@+id/pbMiniProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@color/progressTrack"
        android:progressTint="@color/accentPrimary" />

</LinearLayout>
