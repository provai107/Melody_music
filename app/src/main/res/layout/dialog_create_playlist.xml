<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/youtube_sans_bold_font"
        android:text="New Playlist"
        android:textColor="@color/white_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="Give your new playlist a title"
        android:textColor="@color/muted_grey"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPlaylistNameInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_input_explore"
        android:fontFamily="sans-serif"
        android:hint="e.g. Road Trip Vibes"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/white_primary"
        android:textColorHint="@color/muted_grey"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCreatePlaylist"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="sans-serif-medium"
            android:text="Cancel"
            android:textColor="@color/muted_grey"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmCreatePlaylist"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/youtube_red"
            android:fontFamily="sans-serif-bold"
            android:text="Create"
            android:textColor="@color/white_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
