<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Square Artwork Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRowArtwork"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        app:cardBackgroundColor="@color/surfaceCard"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivRowCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Release Cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </androidx.cardview.widget.CardView>

    <!-- Title & Artist Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/layoutRowActions"
        android:layout_toEndOf="@+id/cardRowArtwork"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/youtube_sans_bold_font"
            android:maxLines="1"
            android:text="Track Title"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRowArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Artist • Album"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tag & Actions -->
    <LinearLayout
        android:id="@+id/layoutRowActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_badge"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="NEW"
            android:textColor="@color/textPrimary"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/btnRowPlay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play release"
            android:padding="8dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/accentPrimary" />
    </LinearLayout>

</RelativeLayout>
