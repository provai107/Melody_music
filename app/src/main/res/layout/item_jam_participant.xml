<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <TextView
            android:id="@+id/tvParticipantAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_jam_code_pill"
            android:backgroundTint="@color/surfaceElevated"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/textPrimary"
            android:textSize="18sp" />

        <!-- Host Crown Badge -->
        <ImageView
            android:id="@+id/ivParticipantCrown"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_jam_crown"
            android:visibility="gone" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvParticipantName"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="1"
        android:text="User"
        android:textColor="@color/textSecondary"
        android:textSize="11sp" />

</LinearLayout>
