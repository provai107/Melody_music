<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_ytm_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="14dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="Trending Search"
        android:src="@drawable/ic_ytm_search"
        app:tint="@color/ytm_icon_inactive" />

    <TextView
        android:id="@+id/tvSearchChipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Coldplay"
        android:textColor="@color/ytm_text_primary"
        android:textSize="13sp" />

</LinearLayout>
