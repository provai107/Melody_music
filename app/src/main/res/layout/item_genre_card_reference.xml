<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGenreRoot"
    android:layout_width="154dp"
    android:layout_height="96dp"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surfaceCard"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <RelativeLayout
        android:id="@+id/layoutGenreContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToOutline="true">

        <!-- Top-Left Genre Title -->
        <TextView
            android:id="@+id/tvGenreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="50dp"
            android:ellipsize="end"
            android:fontFamily="@font/youtube_sans_bold_font"
            android:lineSpacingExtra="-2dp"
            android:maxLines="2"
            android:text="Bollywood"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Bottom-Left Subtitle / Category -->
        <TextView
            android:id="@+id/tvGenreSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="60dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Top Hits"
            android:textColor="#D0FFFFFF"
            android:textSize="10sp" />

        <!-- Bottom-Right Rotated Artwork Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:rotation="20"
            android:translationX="10dp"
            android:translationY="10dp"
            app:cardBackgroundColor="#222222"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/ivGenreArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Genre Artwork"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </androidx.cardview.widget.CardView>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
