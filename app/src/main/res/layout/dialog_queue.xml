<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutQueueSheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ytm_surface_dark"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <!-- Top Drag Handle -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Drag Handle"
        android:src="@drawable/single_bar_drag_handle" />

    <!-- Header Row (YouTube Music Queue Page Header) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivCloseQueue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Queue"
            android:padding="6dp"
            android:src="@drawable/ic_ytm_chevron_down"
            app:tint="@color/ytm_icon_active" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:letterSpacing="0.08"
                android:text="UP NEXT"
                android:textColor="@color/ytm_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvQueueTrackCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="0 tracks • Autoplay On"
                android:textColor="@color/ytm_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearQueue"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="Clear"
            android:textColor="@color/ytm_text_secondary"
            android:textSize="12sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/ytm_divider" />

    <!-- Now Playing Card -->
    <LinearLayout
        android:id="@+id/layoutQueueNowPlayingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mix_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/ytm_surface_card"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivNowPlayingQueueThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Now Playing Art"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06"
                android:text="PLAYING NOW"
                android:textColor="@color/ytm_red"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvNowPlayingQueueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:maxLines="1"
                android:text="No Track Playing"
                android:textColor="@color/ytm_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNowPlayingQueueArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Select a song to start"
                android:textColor="@color/ytm_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Equalizer"
            android:src="@drawable/ic_equalizer"
            app:tint="@color/ytm_red" />
    </LinearLayout>

    <!-- Up Next Subheader -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:text="NEXT IN QUEUE"
            android:textColor="@color/ytm_text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnShuffleQueue"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="🔀 Shuffle"
            android:textColor="@color/ytm_text_primary"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Queue List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for Queue -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQueueList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutQueueEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Empty Queue"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/ytm_icon_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/youtube_sans_bold_font"
                android:text="Your queue is empty"
                android:textColor="@color/ytm_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Search for music or enable Autoplay to keep the music playing infinitely."
                android:textColor="@color/ytm_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
