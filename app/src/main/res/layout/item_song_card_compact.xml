<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Square Cover Art Container with Rounded Corners & Play Button Overlay -->
    <RelativeLayout
        android:layout_width="136dp"
        android:layout_height="136dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/surface_black"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivCardCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Artwork"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </androidx.cardview.widget.CardView>

        <!-- Play Circle Overlay Button (Bottom-Right) -->
        <FrameLayout
            android:id="@+id/btnCardQuickPlay"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="8dp"
            android:background="@drawable/bg_play_circle_red"
            android:clickable="true"
            android:contentDescription="Quick Play"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/white_primary" />
        </FrameLayout>

        <!-- Optional Origin / Ranking Badge (Top-Left) -->
        <TextView
            android:id="@+id/tvCardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pill_badge"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white_primary"
            android:textSize="9sp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Song Title -->
    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/youtube_sans_bold_font"
        android:maxLines="1"
        android:text="Track Title"
        android:textColor="@color/white_primary"
        android:textSize="13sp" />

    <!-- Artist Subtitle Row with Optional 3-Dot Options Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvCardArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btnCardOptions"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Artist Name"
            android:textColor="@color/muted_grey"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btnCardOptions"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Track Options"
            android:padding="2dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/light_grey_inactive" />
    </RelativeLayout>

</LinearLayout>
