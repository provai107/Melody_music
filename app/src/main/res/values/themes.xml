<resources>
    <!-- Base Application Theme: Melody Minimal Dark Theme -->
    <style name="Theme.BraveMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accentPrimary</item>
        <item name="colorPrimaryVariant">@color/surfaceCard</item>
        <item name="colorOnPrimary">@color/textPrimary</item>
        <item name="colorSecondary">@color/accentPrimary</item>
        <item name="colorSecondaryVariant">@color/accentPressed</item>
        <item name="colorOnSecondary">@color/textPrimary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@drawable/bg_ytm_gradient</item>
        <item name="bottomSheetDialogTheme">@style/MelodyBottomSheetDialogTheme</item>
    </style>

    <style name="MelodyBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MelodyBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <style name="MelodyBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Legacy Style Aliases for Seamless Backward Compatibility -->
    <style name="YtmBottomSheetDialogTheme" parent="MelodyBottomSheetDialogTheme" />
    <style name="YtmBottomSheetStyle" parent="MelodyBottomSheetStyle" />
    <style name="TidalBottomSheetDialogTheme" parent="MelodyBottomSheetDialogTheme" />
    <style name="TidalBottomSheetStyle" parent="MelodyBottomSheetStyle" />

    <!-- Melody Typography Styles -->
    <style name="TextAppearance.Melody.DisplayTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/youtube_sans_bold_font</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Melody.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/youtube_sans_bold_font</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Melody.Subheading" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Aliases for previous YTM references -->
    <style name="TextAppearance.YTM.DisplayTitle" parent="TextAppearance.Melody.DisplayTitle" />
    <style name="TextAppearance.YTM.SectionHeader" parent="TextAppearance.Melody.SectionHeader" />
    <style name="TextAppearance.YTM.Subheading" parent="TextAppearance.Melody.Subheading" />
</resources>
