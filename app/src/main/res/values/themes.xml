<resources>
    <!-- Base Application Theme: YouTube Music True Dark Theme with Glow Gradient -->
    <style name="Theme.BraveMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/youtube_red</item>
        <item name="colorPrimaryVariant">@color/surface_black</item>
        <item name="colorOnPrimary">@color/white_primary</item>
        <item name="colorSecondary">@color/youtube_red</item>
        <item name="colorSecondaryVariant">@color/youtube_red</item>
        <item name="colorOnSecondary">@color/white_primary</item>
        <item name="android:colorBackground">@color/deep_black</item>
        <item name="android:statusBarColor">@color/ytm_bg_top_glow</item>
        <item name="android:navigationBarColor">@color/surface_black</item>
        <item name="android:windowBackground">@drawable/bg_ytm_gradient</item>
        <item name="bottomSheetDialogTheme">@style/YtmBottomSheetDialogTheme</item>
    </style>

    <style name="YtmBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/YtmBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/surface_black</item>
    </style>

    <style name="YtmBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Legacy Style Aliases for Seamless Backward Compatibility -->
    <style name="TidalBottomSheetDialogTheme" parent="YtmBottomSheetDialogTheme" />
    <style name="TidalBottomSheetStyle" parent="YtmBottomSheetStyle" />

    <!-- YouTube Music Typography Styles -->
    <style name="TextAppearance.YTM.DisplayTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/youtube_sans_bold_font</item>
        <item name="android:textColor">@color/white_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.YTM.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/youtube_sans_bold_font</item>
        <item name="android:textColor">@color/white_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.YTM.Subheading" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/muted_grey</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
