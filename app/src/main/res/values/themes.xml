<resources>
    <!-- Base Application Theme: TIDAL-Inspired Borderless Dark -->
    <style name="Theme.BraveMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tidal_accent</item>
        <item name="colorPrimaryVariant">@color/tidal_surface</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/tidal_accent</item>
        <item name="colorSecondaryVariant">@color/tidal_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/tidal_bg</item>
        <item name="android:statusBarColor">@color/tidal_bg</item>
        <item name="android:navigationBarColor">@color/tidal_surface</item>
        <item name="android:windowBackground">@color/tidal_bg</item>
        <item name="bottomSheetDialogTheme">@style/TidalBottomSheetDialogTheme</item>
    </style>

    <style name="TidalBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TidalBottomSheetStyle</item>
    </style>

    <style name="TidalBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
